# jimakuChan WhisperLiveKit 設定（whisper_launcher.py が作成．git 管理外）
# 空欄なら ~/.venvs/whisperlivekit（Windows は %USERPROFILE%\.venvs\whisperlivekit）
WHISPER_VENV=
WHISPER_BIND=127.0.0.1
WHISPER_PORT=11437
WHISPER_MODEL=small
# 認識言語（auto で自動検出．アプリ側の言語が WebSocket の ?language= で上書きする）
WHISPER_LANGUAGE=auto
# auto | faster-whisper | whisper | mlx-whisper など
WHISPER_BACKEND=auto
# simulstreaming（AlignAtt・高精度低遅延）| localagreement
WHISPER_BACKEND_POLICY=simulstreaming
# この秒数以上の無音でサーバが lines を区切る（文の区切りはアプリが句読点で作り直すので，
# 区切られても文が途中で切れることはない．0 にするとサーバの確定が止まり未確定 buffer だけになる）
WHISPER_PAUSE_SEGMENTATION_SECONDS=2.0
# 設定すると認証必須（アプリ側の「API キー」欄に同じ値を入れる）
WHISPER_API_TOKEN=
# アプリからモデルを切り替えるための制御 API ポート（127.0.0.1 のみ）
WHISPER_CONTROL_PORT=11436
# Ollama WebSocket ブリッジ（start が起動）
OLLAMA_BRIDGE_PORT=11435
